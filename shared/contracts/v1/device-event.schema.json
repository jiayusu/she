{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://she.local/contracts/v1/device-event.schema.json",
  "title": "DeviceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "contract_version", "device_id", "session_id", "sequence", "occurred_at", "type", "payload"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
    "contract_version": {"const": "1.0"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "sequence": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "pattern": "Z$"},
    "type": {"enum": ["hello", "wake", "touch", "pointing", "device_state", "command_ack", "heartbeat"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "hello"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runtime_version", "capabilities"],
            "properties": {
              "runtime_version": {"type": "string", "minLength": 1},
              "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"enum": ["wake", "touch"]}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": {
              "source": {"enum": ["button", "touch", "voice", "simulator"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "pointing"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "bbox", "confidence", "confirmation_state"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "confirmation_state": {"enum": ["unconfirmed", "confirmed", "rejected"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "device_state"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["online", "battery_percent", "capabilities"],
            "properties": {
              "online": {"type": "boolean"},
              "battery_percent": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
              "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "command_ack"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_id", "status", "error_code"],
            "properties": {
              "command_id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
              "status": {"enum": ["completed", "failed"]},
              "error_code": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "heartbeat"}}},
      "then": {
        "properties": {
          "payload": {"type": "object", "additionalProperties": false, "maxProperties": 0}
        }
      }
    }
  ]
}
