{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://she.local/contracts/v1/rpg-quest-summary.schema.json",
  "title": "RpgQuestSummary",
  "description": "Child-safe, read-only projection of the current embodied-language quest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "learning_revision",
    "turn_id",
    "delivery_status",
    "quest"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "learning_revision": {"type": "integer", "minimum": 0},
    "turn_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "delivery_status": {
      "enum": ["planned", "issuing", "completed", "failed", "expired", null]
    },
    "quest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/quest"}
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,120}$"},
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_id",
        "seed_version",
        "node_id",
        "phase",
        "world_revision",
        "inventory",
        "completed_nodes",
        "confirmed_object",
        "world_role",
        "action_kind",
        "target_expression",
        "prompt_id",
        "feedback_id",
        "next_quest_id"
      ],
      "properties": {
        "seed_id": {"const": "milk_picnic"},
        "seed_version": {"const": 1},
        "node_id": {"enum": ["collect_milk", "find_red_cup", "picnic_ready"]},
        "phase": {
          "enum": [
            "seeking_object",
            "confirming_object",
            "presenting",
            "awaiting_speech",
            "resolving",
            "paused",
            "delivery_failed",
            "completed"
          ]
        },
        "world_revision": {"type": "integer", "minimum": 0},
        "inventory": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"enum": ["milk_token", "red_cup_token"]}
        },
        "completed_nodes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"enum": ["collect_milk", "find_red_cup", "picnic_ready"]}
        },
        "confirmed_object": {"enum": ["fridge", "table", "red_cup", "blue_cup", null]},
        "world_role": {"enum": ["饮品保管员", "杯子管理员", "野餐向导"]},
        "action_kind": {
          "enum": ["ask", "reinvite", "prompt", "recast", "advance_story", "explore", "pause"]
        },
        "target_expression": {"type": "string", "minLength": 1, "maxLength": 120},
        "prompt_id": {"oneOf": [{"$ref": "#/$defs/prompt_id"}, {"type": "null"}]},
        "feedback_id": {"$ref": "#/$defs/content_id"},
        "next_quest_id": {"enum": ["collect_milk", "find_red_cup", null]}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {"enum": ["presenting", "awaiting_speech", "resolving", "delivery_failed"]}
            }
          },
          "then": {
            "properties": {
              "confirmed_object": {"enum": ["fridge", "table", "red_cup", "blue_cup"]}
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {"enum": ["seeking_object", "confirming_object", "completed"]}
            }
          },
          "then": {"properties": {"confirmed_object": {"const": null}}}
        },
        {
          "if": {"properties": {"node_id": {"const": "collect_milk"}}},
          "then": {
            "properties": {
              "phase": {"not": {"const": "completed"}},
              "world_revision": {"const": 1},
              "inventory": {"const": []},
              "completed_nodes": {"const": []},
              "confirmed_object": {"enum": ["fridge", null]},
              "world_role": {"const": "饮品保管员"},
              "target_expression": {"const": "I want milk."},
              "feedback_id": {
                "enum": [
                  "collect_milk_s0", "collect_milk_s1", "collect_milk_s2",
                  "collect_milk_s3", "collect_milk_s4", "collect_milk_s5",
                  "collect_milk_s6", "milk_help"
                ]
              },
              "next_quest_id": {"const": "collect_milk"}
            }
          }
        },
        {
          "if": {"properties": {"node_id": {"const": "find_red_cup"}}},
          "then": {
            "properties": {
              "phase": {"not": {"const": "completed"}},
              "world_revision": {"const": 2},
              "inventory": {"const": ["milk_token"]},
              "completed_nodes": {"const": ["collect_milk"]},
              "confirmed_object": {"enum": ["table", "red_cup", "blue_cup", null]},
              "world_role": {"const": "杯子管理员"},
              "target_expression": {"const": "I choose the red cup."},
              "feedback_id": {
                "enum": [
                  "find_red_cup_s0", "find_red_cup_s1", "find_red_cup_s2",
                  "find_red_cup_s3", "find_red_cup_s4", "find_red_cup_s5",
                  "find_red_cup_s6", "milk_ready", "red_cup_help"
                ]
              },
              "next_quest_id": {"const": "find_red_cup"}
            }
          }
        },
        {
          "if": {"properties": {"node_id": {"const": "picnic_ready"}}},
          "then": {
            "properties": {
              "phase": {"const": "completed"},
              "world_revision": {"const": 4},
              "inventory": {"const": ["milk_token", "red_cup_token"]},
              "completed_nodes": {"const": ["collect_milk", "find_red_cup", "picnic_ready"]},
              "confirmed_object": {"const": null},
              "world_role": {"const": "野餐向导"},
              "target_expression": {"const": "Our picnic is ready."},
              "feedback_id": {
                "enum": [
                  "picnic_ready_s0", "picnic_ready_s1", "picnic_ready_s2",
                  "picnic_ready_s3", "picnic_ready_s4", "picnic_ready_s5",
                  "picnic_ready_s6", "red_cup_ready", "picnic_complete", "picnic_pause"
                ]
              },
              "next_quest_id": {"const": null}
            }
          }
        }
      ]
    },
    "prompt_id": {
      "enum": [
        "collect_milk_s0", "collect_milk_s1", "collect_milk_s2",
        "collect_milk_s3", "collect_milk_s4", "collect_milk_s5", "collect_milk_s6",
        "find_red_cup_s0", "find_red_cup_s1", "find_red_cup_s2",
        "find_red_cup_s3", "find_red_cup_s4", "find_red_cup_s5", "find_red_cup_s6",
        "picnic_ready_s0", "picnic_ready_s1", "picnic_ready_s2",
        "picnic_ready_s3", "picnic_ready_s4", "picnic_ready_s5", "picnic_ready_s6"
      ]
    },
    "content_id": {
      "enum": [
        "collect_milk_s0", "collect_milk_s1", "collect_milk_s2",
        "collect_milk_s3", "collect_milk_s4", "collect_milk_s5", "collect_milk_s6",
        "find_red_cup_s0", "find_red_cup_s1", "find_red_cup_s2",
        "find_red_cup_s3", "find_red_cup_s4", "find_red_cup_s5", "find_red_cup_s6",
        "picnic_ready_s0", "picnic_ready_s1", "picnic_ready_s2",
        "picnic_ready_s3", "picnic_ready_s4", "picnic_ready_s5", "picnic_ready_s6",
        "milk_ready", "milk_help", "red_cup_ready", "red_cup_help",
        "picnic_complete", "picnic_pause"
      ]
    }
  }
}
