# Copy to /etc/she-device.env on the board; keep the real file root-only (0600).
SHE_GATEWAY_WS=wss://gateway.example/v1/device/session
SHE_DEVICE_ID=rx5-physical-001
SHE_DEVICE_TOKEN=replace-with-gateway-enrollment-token
SHE_HARDWARE_MODE=rdk
SHE_FIRMWARE_VERSION=board-firmware-version
SHE_RUNTIME_VERSION=0.1.0
SHE_CAMERA_INDEX=0
SHE_GPIO_PIN=replace-with-operator-verified-pin
SHE_FALLBACK_WAV=/opt/she/assets/fallback.wav
