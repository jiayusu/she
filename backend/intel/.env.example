# ==== 知乎开放平台 (密钥不进代码库, 见 §5) ====
ZHIHU_API=your_access_secret
# Provider: zhihu_api=官方API | manual=人工导入降级 (§8 风险对策)
ZHIHU_PROVIDER=zhihu_api
# 三用途共用日配额上限 (PRD 假设 1000/天; 平台实际 zhihu_search=5000, 取保守值可调)
ZHIHU_DAILY_LIMIT=1000

# ==== KG 热更新接口 (FR-I04 写入方) ====
KG_URL=http://127.0.0.1:8787

# ==== LLM (FR-I03/05/06 结构化方, OpenAI 兼容) ====
LLM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MIN_INTERVAL=10.5

# ==== 企业微信机器人 (FR-I05/06 推送方; 留空则只写 outbox 待发送) ====
WECOM_WEBHOOK=

# ==== 服务 ====
INTEL_PORT=8791
INTEL_DB=
